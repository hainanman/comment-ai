# 复制为 .env 后修改；不要提交 .env
FLASK_SECRET_KEY=replace-with-a-random-string
DATABASE_URL=mysql+pymysql://comment_ai:change-me@127.0.0.1:3306/comment_ai?charset=utf8mb4
# 本地无 MySQL 时可临时用 SQLite 冒烟：
# DATABASE_URL=sqlite:///comment_ai.db

DASHSCOPE_API_KEY=
AI_ENABLED=true
LLM_JSON_MODE=true
REVIEW_THRESHOLD=0.50
REJECT_THRESHOLD=0.85
DAILY_LLM_LIMIT=300
# 可选：HTTPS 部署时设为 true
SESSION_COOKIE_SECURE=false
